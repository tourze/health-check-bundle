{
  "name": "tourze/health-check-bundle",
  "description": "Symfony应用程序健康检查组件，支持SQL检查、内置扩展检查等多种健康状态监控功能",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "ext-json": "*",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^2.13",
    "doctrine/orm": "^3.0",
    "doctrine/persistence": "^4.1",
    "dragonmantank/cron-expression": "^3.4",
    "easycorp/easyadmin-bundle": "^4",
    "knplabs/knp-menu": "^3.7",
    "laminas/laminas-diagnostics": "^1.27",
    "symfony/config": "^7.3",
    "symfony/console": "^7.3",
    "symfony/dependency-injection": "^7.3",
    "symfony/doctrine-bridge": "^7.3",
    "symfony/framework-bundle": "^7.3",
    "symfony/http-foundation": "^7.3",
    "symfony/http-kernel": "^7.3",
    "symfony/security-bundle": "^7.3",
    "symfony/security-http": "^7.3",
    "symfony/yaml": "^7.3",
    "tourze/bundle-dependency": "1.*",
    "tourze/doctrine-indexed-bundle": "1.0.*",
    "tourze/doctrine-timestamp-bundle": "0.0.*",
    "tourze/doctrine-track-bundle": "0.1.*",
    "tourze/doctrine-user-bundle": "0.0.*",
    "tourze/easy-admin-enum-field-bundle": "1.0.*",
    "tourze/easy-admin-menu-bundle": "0.1.*",
    "tourze/enum-extra": "1.*",
    "tourze/symfony-dependency-service-loader": "1.*"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "tourze/phpunit-doctrine-entity": "1.*",
    "tourze/phpunit-enum": "1.*",
    "tourze/phpunit-symfony-kernel-test": "1.*",
    "tourze/phpunit-symfony-unit-test": "1.*",
    "tourze/phpunit-symfony-web-test": "1.*"
  },
  "autoload": {
    "psr-4": {
      "HealthCheckBundle\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HealthCheckBundle\\Tests\\": "tests"
    }
  }
}